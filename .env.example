# Cloudflare API token — scoped to Zone.DNS edit for the domain.
# Used by Caddy (DNS-01 certs) and cloudflare-ddns.
CF_API_TOKEN=
# ACME registration email for Let's Encrypt (Caddy)
ACME_EMAIL=
# Sonarr API key (Settings → General) — used by the scheduled-search sidecar.
SONARR_API_KEY=
# Optional: first date the Google Health importer backfills from.
GOOGLE_HEALTH_START_DATE=2026-06-02
