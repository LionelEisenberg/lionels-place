# --- Auth ---
JWT_SECRET=            # openssl rand -hex 32
JELLYFIN_URL=http://jellyfin:8096
HELM_ADMIN_USERS=      # comma-separated Jellyfin usernames with admin role
# --- LLM providers ---
LLM_PROVIDER=claude    # claude | gemini
LLM_MODEL=
LLM_EFFORT=
LLM_FALLBACK=
CLAUDE_CODE_OAUTH_TOKEN=   # claude setup-token
GEMINI_PAID_KEY=
GEMINI_FREE_KEY_1=
GEMINI_FREE_KEY_2=
GEMINI_PRO_MODEL=
GEMINI_FLASH_MODEL=
GEMINI_FLASH_3_MODEL=
GEMINI_FLASH_25_MODEL=
GEMINI_FLASH_LITE_MODEL=
# Advanced worker tuning (CLAUDE_MAX_TURNS, WORKER_POLL_INTERVAL, GEMINI_FREE_*_LIMIT, ...) has sane code defaults — see helm/bridge/
# --- Daily targets ---
DAILY_PROTEIN_TARGET=140
DAILY_CARBS_TARGET=190
DAILY_FAT_TARGET=60
DAILY_FIBER_TARGET=30
DAILY_CALORIE_TARGET=1850
# --- Custom habit (see backend/services/habit_config.py) ---
HABIT_LABEL=Habit
HABIT_EMOJI=✳️
HABIT_UNIT=g
HABIT_SYNONYMS=
# --- Integrations ---
GITHUB_TOKEN=          # optional: leetcode/apps features
GITHUB_REPO=
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
GOOGLE_HEALTH_REDIRECT_URI=
OAUTH_ENCRYPTION_KEY=  # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HEALTH_SYNC_SECRET=    # openssl rand -hex 16 — shared by helm + helm-health-sync sidecar
HELM_WORKER_SECRET=    # openssl rand -hex 16 — shared by helm + llm-worker
HELM_PHOTOS_DIR=/app/photos
